/ --------------------------------------------------- QUEBRAR VIRGULAS 

//-----SEPARANDO VIRGULAS (E41)
//SEPARANDO VIRGULAS - e41
MATCH (n:E41_Appellation) WHERE n.E41Designation CONTAINS ';'
    WITH n, split(n.E41Designation, ';') AS E41_AppellationDivided
    SET n.E41Designation = E41_AppellationDivided[0]
    WITH n, E41_AppellationDivided
    UNWIND E41_AppellationDivided[1..] AS Designation2 //pega todos os valores depois do 1
    CREATE (n)-[:P139_has_alternative_form]->(x:E41_Appellation {a:Designation2})
RETURN n, x

//-----SEPARANDO VIRGULAS (E57) 
MATCH(m:E24_Human_Made_Object)-[r: P45_is_incorporated_in]-(n:E57_Material) WHERE n.a CONTAINS ';'
WITH m, n, split(n.a, ';') AS E57_MaterialDivided
//SET n.a = E57_MaterialDivided [0]
//WITH m, n, E57_MaterialDivided
DETACH DELETE n
WITH m,E57_MaterialDivided
UNWIND E57_MaterialDivided[0..] AS Material2 //pega todos os valores depois do 1
MERGE (x:E57_Material {a:Material2})
CREATE (m)<-[:P45_is_incorporated_in]-(x)
CREATE (x)<-[:P45_consists_of]-(m)

RETURN x, m

