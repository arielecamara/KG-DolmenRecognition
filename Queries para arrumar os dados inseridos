// ---------------------------------------------- RETURNAR POLIGONO ID MAIS PROXIMO DO PONTO DO DOLMEN X

MATCH (n:E22_Human_Made_Object)-[]-(dol:SP6_Declarative_Place) WHERE n.a="Remendo 2"
    MATCH (dol)-[]-(d:E94_Space_Primitive)
    MATCH (d)-[]-(coord:SP4_Spatial_Coordinate_Reference_System) WHERE coord.a="WGS84"
        WITH point ({latitude: toFloat(d.lat), longitude: toFloat(d.lon)}) AS dd, dol
MATCH (p:E94_Space_Primitive)--()--(pol:E42_Identifier),(pol)--(:)
    WITH point({latitude: toFloat(p.latitude), longitude:toFloat(p.longitude)}) AS pp,pol,dd, dol
    WHERE  point.distance(pp, dd)<100

RETURN distinct pol 

// ---------------------------------------------- RETURNAR POLIGONO ID MAIS PROXIMO DO PONTO DO DOLMEN X (...)

MATCH (n:E22_Human_Made_Object)-[]-(dol:SP6_Declarative_Place) WHERE n.a="Remendo 2"
    MATCH (dol)-[]-(d:E94_Space_Primitive)
    MATCH (d)-[]-(coord:SP4_Spatial_Coordinate_Reference_System) WHERE coord.a="WGS84"
        WITH point ({latitude: toFloat(d.lat), longitude: toFloat(d.lon)}) AS dd, dol
MATCH (p:E94_Space_Primitive)--()--(pol:E42_Identifier)
    WITH point({latitude: toFloat(p.latitude), longitude:toFloat(p.longitude)}) AS pp,pol,dd, dol
    WHERE  point.distance(pp, dd)<100
MATCH (pol)-[:P48_is_preferred_identifier_of]->(:SP6_Declarative_Place)-[:P130_shows_features_of]->(:E55_Type)-[:P127_has_broader_term]->(:E55_Type)-[:P127_has_broader_term]->(:E55_Type)-[:P127_has_broader_term]->(:E55_Type)<-[:P2_has_type]-(ano:E17_Type_Assigment) WHERE ano.a = "The soil use type assigning of COS 2018" 

RETURN distinct pol, ano 
