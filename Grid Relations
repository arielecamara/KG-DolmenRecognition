//8.1 Grid: DOLMEN PA

:auto LOAD CSV WITH HEADERS FROM "file:///GrelhaDolmensPA.csv" AS ROW

CALL {WITH ROW

MATCH (geoFeature: Geo_Feature {GridID: ROW.GrelhaID})

WITH geoFeature, ROW

MATCH (E31Document:E31_Document {E31Document: "PA - MAP WEB"})-[:P70_documents]->(:E13_Attribute_Assignment)-[:P140_assigned_attribute_to]->(E22:E22_Human_Made_Object)-[:P55_has_current_location]->(:SP6_Declarative_Place)-[:P168_place_is_defined_by]->(E94:E94_Space_Primitive), (E42GlobalID:E42_Identifier{E42GlobalID:ROW.IDGlobal})<-[]-(E22)

MERGE (E94)-[r:sfWithin]->(geoFeature)

} IN TRANSACTIONS OF 100 ROWS

