// --------------------------------------------------- GRIDS

//8. Grid: INSERTION

:auto LOAD CSV WITH HEADERS FROM "file:///GrelhacomWKT_QGIS.csv" AS ROW

CALL {WITH ROW

CREATE (geoFeature: Geo_Feature {GridID: ROW.GridID})
CREATE (C1AreaHa:C1_Geometry_extracted_from_maps {GLE3AreaHa: ROW.Shape_Area})
CREATE (C1Lenght:C1_Geometry_extracted_from_maps {GLE10_Lenght: ROW.Shape_Leng})
CREATE (geoGeometry: Geo_Geometry {WKT: ROW.WKT})


CREATE (C1Lenght)-[:GLP1_space_primitive_is_defined_by]->(geoFeature)
CREATE (C1Lenght)<-[:GLP1_defines_space_primitive]-(geoFeature)

CREATE (C1AreaHa)-[:GLP1_space_primitive_is_defined_by]->(geoFeature)
CREATE (C1AreaHa)<-[:GLP1_defines_space_primitive]-(geoFeature)


CREATE (geoFeature)-[:geo_hasGeometry]->(geoGeometry)

} IN TRANSACTIONS OF 100 ROWS


