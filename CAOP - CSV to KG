MERGE (E41Appelation:E41_Appellation {E41DesignationMaps:"Carta Administrativa Oficial de Portugal"})
MERGE (E52TimeSpanMaps:E52_Time_Span {E52TimeSpanMaps:"2022"})
MERGE (E52TimeSpanAcquisition:E52_Time_Span {E52TimeSpanAcquisition:"2023"}) // Nova Adicao da versao 2
MERGE (E28ConceptualObject:E28_Conceptual_Object {E28ConceptualObject:"CAOP 2022 "})
MERGE (E55Concepts:E55_Type {E55TypeObject:"Cartografia Digital de Poligono"}) //Mudanca da chave valor versao 2

// CONCEPTS (GENERAL DEFINITION)
MERGE (E17Taxonomy:E17_Type_Assigment {E17TerminologyDefinition:"Regiões Administrativas"})
MERGE (E55Terminology:E55_Type {E55Terminology:"Terminologia utilizada para representar a:  "+E28ConceptualObject.E28ConceptualObject}) // Nova Adicao da versao 2
MERGE (E55TerminologyType1:E55_Type {E55TerminologyType:"País", c: 1})
MERGE (E55TerminologyType2:E55_Type {E55TerminologyType:"Distrito", c: 2})
MERGE (E55TerminologyType3:E55_Type {E55TerminologyType:"Concelho", c: 3})
MERGE (E55TerminologyType4:E55_Type {E55TerminologyType:"Freguesia", c: 4})

// PLACE
MERGE (E53Pais:E53_Place {E53Place:"Portugal"})
MERGE (E53Distrito:E53_Place {E53Place:ROW.Distrito})
MERGE (E53Concelho:E53_Place {E53Place:ROW.Concelho})
MERGE (E53Freguesia:E53_Place {E53Place:ROW.Freguesia})

// CONCEPTS (INDIVIDUAL DEFINITION) ---  Nova Adicao da versao 2
CREATE (E18SpecificResource:E18_Phisical_Thing {E18SpecificResource:"Território de:  " +E53Freguesia.E53Place})

// GEOMETRY

MERGE (E42PolygonID:E42_Identifier {E42PolygonID:ROW.DICOFRE,E42PolygonIDGis:ROW.IDGis})
CREATE (SP6PlacePolygon:SP6_Declarative_Place {SP6DeclarativePlace:"O lugar definido pelo poligono:  "+E42PolygonID.E42PolygonID})
CREATE (E94WKT:E94_Space_Primitive {E94PolygonWKT:ROW.WKT})
MERGE (SP4DatumWKT:SP4_Spatial_Coordinate_Reference_System {SP4Datum:"WKT"})
MERGE (SP15Polygon:SP15_Geometry {SP15Geometry:"Multipoligono"})

MERGE (C1AreaHATotal:C1_Geometry_extracted_from_maps {GLE3_Area_Ha: ROW.Area_T_ha}) // Total value 
CREATE (C1AreaHAindividual:C1_Geometry_extracted_from_maps {GLE3_Area_Ha: ROW.Area_EA_ha}) // Individual value


// ----------------- RELATIONSHIPS

// -- DEFINITION
MERGE (E65CreationEvents)-[:P94_has_created]->(E28ConceptualObject)
MERGE (E65CreationEvents)<-[:P94_was_created_by]-(E28ConceptualObject)


