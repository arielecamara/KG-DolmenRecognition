//2Query:CartografiaCAOP

LOAD CSV WITH HEADERS FROM "file:///CAOP2022-Pais.v3.WGS84.csv" AS ROW

// ------------------- ENTITIES

// DEFINITION
MERGE (E74Group:E74_Group {E74Group:"Direção-Geral do Território (DGT)"})-[:P14_performed]->(E65CreationEvents:E65_Creation {E65CreationEvents:"RSI Analises"})
