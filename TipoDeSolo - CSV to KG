//3.1Query:CartografiaTipoDeSolo

LOAD CSV WITH HEADERS FROM "file:///SoilType.UTF8.WGS84.csv" AS ROW

// ------------------- ENTITIES

// DEFINITION ENTITIES
MERGE (E74Group:E74_Group {E74Group:"Direção-Geral de Agricultura e Desenvolvimento Rural (DGADR)"})-[:P14_performed]->(E65CreationEvents:E65_Creation {E65CreationEvents:"RSI Analises"})
MERGE (E74Group)<-[:P14_carried_out_by]-(E65CreationEvents)

MERGE (E41Appelation:E41_Appellation {E41DesignationMaps:"Cartografia dos Solos à escala 1: 25 000 (Sul)"})
MERGE (E52TimeSpanMaps:E52_Time_Span {E52TimeSpanMaps:"2021"})
MERGE (E52TimeSpanAcquisition:E52_Time_Span {E52TimeSpanAcquisition:"2023"}) // Nova Adicao da versao 2
MERGE (E28ConceptualObject:E28_Conceptual_Object {E28ConceptualObject:"Cartografia dos Solos à escala 1: 25 000 (Sul)"})
MERGE (E55Concepts:E55_Type {E55TypeObject:"Cartografia Digital de Poligono"}) //Mudanca da chave valor versao 2

// -- DEFINITION RELATIONSHIPS
MERGE (E65CreationEvents)-[:P94_has_created]->(E28ConceptualObject)
MERGE (E65CreationEvents)<-[:P94_was_created_by]-(E28ConceptualObject)

MERGE (E28ConceptualObject)-[:P4_has_time_span]->(E52TimeSpanMaps)
MERGE (E28ConceptualObject)<-[:P4_is_time_span_of]-(E52TimeSpanMaps)
MERGE (E28ConceptualObject)-[:P4_has_time_span]->(E52TimeSpanAcquisition)
MERGE (E28ConceptualObject)<-[:P4_is_time_span_of]-(E52TimeSpanAcquisition)
MERGE (E28ConceptualObject)-[:P1_is_identified_by]->(E41Appelation)
MERGE (E28ConceptualObject)<-[:P1_identifies]-(E41Appelation)
MERGE (E28ConceptualObject)-[:P2_has_type]->(E55Concepts)

// CONCEPTS (GENERAL DEFINITION)
MERGE (E17Taxonomy:E17_Type_Assigment {E17TerminologyDefinition:"Tipo de Solo"})
MERGE (E55Terminology:E55_Type {E55Terminology:"Terminologia utilizada para representar o tipo de uso do solo na:  "+E28ConceptualObject.E28ConceptualObject}) 

// -- CONCEPTS (GENERAL DEFINITION) RELATIONSHIPS

MERGE (E28ConceptualObject)<-[:P41_was_classified_by]-(E17Taxonomy)
MERGE (E28ConceptualObject)-[:P41_classified]->(E17Taxonomy)
MERGE (E17Taxonomy)-[:P2_has_type]->(E55Terminology)


// CONCEPTS (INDIVIDUAL DEFINITION) ---  Nova Adicao da versao 2
CREATE (E18SpecificResource:E18_Phisical_Thing {E18SpecificResource:"Tipos de Solos:  "})


WITH E18SpecificResource, E17Taxonomy, ROW
FOREACH (n IN (CASE WHEN ROW.COD1_solos IS NULL THEN [] ELSE [1] END) |
	MERGE (E55TerminologyType1:E55_Type {E55TerminologyType:  split(ROW.COD1_solos,'(')[0]}) //d=Diferents dates that I dont know if is hierarch levels
		SET E18SpecificResource.E18SpecificResource = E18SpecificResource.E18SpecificResource +E55TerminologyType1.E55TerminologyType
			MERGE (E18SpecificResource)-[:P137_exemplifies]->(E55TerminologyType1)-[:P137_is_exemplified_by]->(E18SpecificResource)
			MERGE (E17Taxonomy)-[:P2A1_assigned_definition_types]->(E55TerminologyType1)
)

WITH E18SpecificResource, E17Taxonomy, ROW
FOREACH (n IN (CASE WHEN ROW.COD2_Solos IS NULL THEN [] ELSE [1] END) |
	MERGE (E55TerminologyType2:E55_Type {E55TerminologyType:  split(ROW.COD2_Solos,'(')[0]})
		SET E18SpecificResource.E18SpecificResource = E18SpecificResource.E18SpecificResource +", " +E55TerminologyType2.E55TerminologyType
		MERGE (E18SpecificResource)-[:P137_exemplifies]->(E55TerminologyType2)
		MERGE (E17Taxonomy)-[:P2A1_assigned_definition_types]->(E55TerminologyType2)
		//MERGE (E18SpecificResource)<-[:P137_is_exemplified_by]-(E55TerminologyType2)

)

WITH E18SpecificResource, E17Taxonomy, ROW
FOREACH (n IN (CASE WHEN ROW.COD3_Solos IS NULL THEN [] ELSE [1] END) |
	MERGE (E55TerminologyType3:E55_Type {E55TerminologyType:  split(ROW.COD3_Solos,'(')[0]})
		SET E18SpecificResource.E18SpecificResource = E18SpecificResource.E18SpecificResource +", " +E55TerminologyType3.E55TerminologyType
		MERGE (E18SpecificResource)-[:P137_exemplifies]->(E55TerminologyType3)
		MERGE (E17Taxonomy)-[:P2A1_assigned_definition_types]->(E55TerminologyType3)
		//MERGE (E18SpecificResource)<-[:P137_is_exemplified_by]-(E55TerminologyType3)
)


// GEOMETRY

CREATE (E94WKT:E94_Space_Primitive {E94PolygonWKT:ROW.WKT})
MERGE (SP4DatumWKT:SP4_Spatial_Coordinate_Reference_System {SP4Datum:"WKT"})
MERGE (SP15Polygon:SP15_Geometry {SP15Geometry:"Multipoligono"})

MERGE (E42PolygonID:E42_Identifier {E42PolygonID: ROW.Soil_ID
})
CREATE (SP6PlacePolygon:SP6_Declarative_Place {SP6DeclarativePlace:"O lugar definido pelo Poligono:  "+E42PolygonID.E42PolygonID})


// PLACE
//MERGE (E53Pais:E53_Place {E53Place:"Portugal"})
MERGE (E53Freguesia:E53_Place {E53Place:"Pavia"})



// -- GEOMETRY RELATIONSHIPS

CREATE (E18SpecificResource)-[:P67_is_referred_to_by]->(SP6PlacePolygon)
CREATE (E18SpecificResource)<-[:P67_refers_to]-(SP6PlacePolygon)
CREATE (E42PolygonID)-[:P48_is_preferred_identifier_of]->(SP6PlacePolygon)
CREATE (E42PolygonID)<-[:P48_has_preferred_identifier]-(SP6PlacePolygon)
CREATE (SP6PlacePolygon)-[:P168_place_is_defined_by]->(E94WKT)
CREATE (SP6PlacePolygon)<-[:P168_defines_place]-(E94WKT)
CREATE (E94WKT)-[:Q9_is_expressed_in_terms_of]->(SP4DatumWKT)
CREATE (E94WKT)-[:geo_hasGeometry]->(SP15Polygon)

// -- PLACE
MERGE (SP6PlacePolygon)-[:P89_falls_within]->(E53Freguesia)
MERGE (SP6PlacePolygon)<-[:P89_contains]-(E53Freguesia)
